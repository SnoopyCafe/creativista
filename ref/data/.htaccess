# Block all web access to the collected data.
# The CSV is readable through Hostinger's File Manager / FTP, never over HTTP.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: never hand these files to a browser even if the rules above
# are overridden somewhere upstream.
<FilesMatch "\.(csv|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes
